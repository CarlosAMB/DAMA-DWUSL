rules_version = '2';

// Reglas de seguridad de Cloud Firestore para EasyLife.
// - Cada usuario solo puede LEER su propia carpeta users/{uid}/... (uid de Firebase Authentication).
// - Nadie escribe desde la app: el servidor Laravel escribe con la cuenta de servicio (que no pasa por estas reglas).
// - Todo lo demas queda bloqueado.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
