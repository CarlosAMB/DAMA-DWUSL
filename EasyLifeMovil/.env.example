# Copiar como .env y reiniciar Expo con: npx expo start --clear

# URL del servidor Laravel (vacio = emulador local http://10.0.2.2:8000)
# Ej. servidor en Render: https://easylife.onrender.com
EXPO_PUBLIC_API_URL=

# Firebase > Configuracion del proyecto > Tus apps > App web (</>)
# Vacio = la app inicia sesion directo con Laravel (sin Firebase)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
